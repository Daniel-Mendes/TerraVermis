{
  "type": "minecraft:disk",
  "config": {
    "half_height": 2,
    "radius": {
      "type": "minecraft:uniform",
      "min_inclusive": 2,
      "max_inclusive": 6
    },
    "state_provider": {
      "fallback": {
        "type": "minecraft:simple_state_provider",
        "state": {
          "Name": "terra-vermis:wormy_dirt"
        }
      },
      "rules": [
        {
          "if_true": {
            "type": "minecraft:matching_blocks",
            "blocks": "minecraft:mycelium",
            "offset": [0, 0, 0]
          },
          "then": {
            "type": "minecraft:simple_state_provider",
            "state": {
              "Name": "terra-vermis:wormy_mycelium"
            }
          }
        }
      ]
    },
    "target": {
      "type": "minecraft:matching_blocks",
      "blocks": [
        "minecraft:mycelium",
        "minecraft:dirt"
      ]
    }
  }
}
